#!/bin/sh
# Manually exercise pinentry-dmenu through its Assuan input protocol.
# Requires a built ./pinentry-dmenu. Modes 1-10 and 12 require an X display;
# mode 11 tests protocol handling without opening the UI.
#
# Usage: ./test [MODE]
# Modes: 1 basic PIN, 2 confirm, 3 repeat PIN, 4-5 multiline descriptions,
#        6 labeled confirmation, 7 message, 8 error, 9 timeout, 10 repeat error,
#        11 empty CLEARPASSPHRASE, 12 escaped button labels. Unknown MODE runs
#        full flow.

case "${1:-}" in
  1)
    ./pinentry-dmenu << 'ASSUAN'
SETTITLE title
SETPROMPT prompt
SETDESC PROMPT
GETPIN
BYE
ASSUAN
    ;;
  2)
    ./pinentry-dmenu << 'ASSUAN'
SETTITLE title
SETPROMPT confirm
SETDESC CONFIRM
confirm
BYE
ASSUAN
    ;;
  3)
    ./pinentry-dmenu << 'ASSUAN'
SETTITLE title
SETPROMPT prompt
SETDESC REPEAT
SETREPEAT repeat
GETPIN
BYE
ASSUAN
    ;;
  4)
    description='First dmenu-style description line%0A'
    description="${description}Second description line%0A"
    description="${description}Third description line%0A"
    description="${description}Fourth description line%0A"
    description="${description}Fifth description line%0A"
    description="${description}Fifth description line"
    {
      printf '%s\n' 'SETTITLE title'
      printf '%s\n' 'SETPROMPT prompt'
      printf 'SETDESC %s\n' "$description"
      printf '%s\n' 'GETPIN' 'BYE'
    } | ./pinentry-dmenu
    ;;
  5)
    description='First dmenu-style description line%0A'
    description="${description}Second description line%0A"
    description="${description}Third description line%0A"
    description="${description}Fourth description line%0A"
    description="${description}Fifth description line%0A"
    description="${description}Fifth description line%0A"
    description="${description}Sixth description line"
    {
      printf '%s\n' 'SETTITLE title'
      printf '%s\n' 'SETPROMPT prompt'
      printf 'SETDESC %s\n' "$description"
      printf '%s\n' 'GETPIN' 'BYE'
    } | ./pinentry-dmenu
    ;;
  6)
    ./pinentry-dmenu << 'ASSUAN'
SETTITLE Confirmation
SETDESC Choose an action
SETOK _OK
SETNOTOK _Reject
SETCANCEL _Cancel
CONFIRM
BYE
ASSUAN
    ;;
  7)
    ./pinentry-dmenu << 'ASSUAN'
SETTITLE Message
SETDESC This is a one-button message
SETOK _Dismiss
MESSAGE
BYE
ASSUAN
    ;;
  8)
    ./pinentry-dmenu << 'ASSUAN'
SETTITLE Error test
SETERROR Example error from GPG
SETDESC Enter a test PIN
GETPIN
BYE
ASSUAN
    ;;
  9)
    ./pinentry-dmenu << 'ASSUAN'
SETTITLE Timeout test
SETPROMPT prompt
SETDESC This request expires automatically
SETTIMEOUT 3
GETPIN
BYE
ASSUAN
    ;;
  10)
    ./pinentry-dmenu << 'ASSUAN'
SETTITLE Repeat test
SETPROMPT prompt
SETDESC Enter same PIN twice
SETREPEAT Repeat PIN
SETREPEATERROR PINs did not match
GETPIN
BYE
ASSUAN
    ;;
  11)
    ./pinentry-dmenu << 'ASSUAN'
CLEARPASSPHRASE
BYE
ASSUAN
    ;;
  12)
    ./pinentry-dmenu << 'ASSUAN'
SETTITLE Escaped labels
SETDESC Doubled underscores display literally
SETOK __OK
SETCANCEL __Cancel
CONFIRM
BYE
ASSUAN
    ;;
  *)
    ./pinentry-dmenu << 'ASSUAN'
SETTITLE title
SETPROMPT prompt
SETDESC PROMPT
GETPIN
SETPROMPT confirm
SETDESC CONFIRM
confirm
SETPROMPT repeat
SETDESC REPEAT
SETREPEAT
GETPIN
BYE
ASSUAN
    ;;
esac
